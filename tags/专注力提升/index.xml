    <item>
      <title>文殊菩萨法：智慧养生功</title>
      <link>https://vanvj00001.github.io/wellness/posts/tibetan-buddhist-practices/manjushri-wisdom/</link>
      <pubDate>Sat, 09 May 2026 17:00:00 +0800</pubDate>
